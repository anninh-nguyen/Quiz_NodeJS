// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  name     String?
  quizzes  Quiz[] 
  questions Question[]
  quizAttempts  QuizAttempt[]
  @@map("users")
}

model Quiz {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  userId      Int?
  questions   Question[]
  quizAttempts QuizAttempt[]
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@map("quizzes")
}

model Question {
  id       Int      @id @default(autoincrement())
  text     String
  quizId   Int
  userId   Int?
  keywords Keyword[]
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  options  Option[]
  quizResults QuizResult[]
  @@map("questions")
}

model Keyword {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(20)
  questions  Question[]
  @@map("keywords")
}

model Option {
  id         Int      @id @default(autoincrement())
  text       String
  isCorrect  Boolean
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quizResults QuizResult[]
  @@map("options")
}

model QuizAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  quizId    Int
  score     Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quizResults QuizResult[]
  @@map("quizAttempts")
}

model QuizResult {
  id            Int      @id @default(autoincrement())
  quizAttemptId Int
  questionId    Int
  selectedOptionId Int
  quizAttempt   QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  selectedOption Option     @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@map("quizResults")
}