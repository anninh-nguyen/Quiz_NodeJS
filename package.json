{
  "name": "quiz_nodejs",
  "version": "1.0.0",
  "description": "WOHI 2 project",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "DATABASE_URL=mysql://root:root@localhost:3306/quiz_test npx prisma migrate deploy",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "express",
    "nodejs",
    "backend",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "vitest": "^4.1.6"
  }
}
